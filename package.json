{
  "name": "railtymaps",
  "description": "Door-to-door transit times on Zillow and Redfin listings for everyone in your household. Chrome extension for US home search.",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "store-assets": "wxt build && node scripts/store-assets/shoot.mjs",
    "site-assets": "node scripts/site/build-assets.mjs"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devAgam/railtymaps.git"
  },
  "homepage": "https://github.com/devAgam/railtymaps",
  "bugs": {
    "url": "https://github.com/devAgam/railtymaps/issues"
  }
}
